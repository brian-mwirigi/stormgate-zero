# Meta Model API (hosted SAM 3.1, Muse Wonder, Muse Image, Muse Voice)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Hosted open-weight endpoints (OpenRouter / Modal / Baseten / Together / Meta)
# Falls back to MODEL_API_KEY and META_BASE_URL when unset.
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_BASE_URL=https://api.meta.ai/v1

# Verified hosted ids on https://api.meta.ai/v1: muse-wonder-1.0, muse-image-1.0.
# Open-weight ids are the partner strings. api.meta.ai answers model_not_found for
# both of them; set OPEN_WEIGHT_BASE_URL to the Baseten (or other) endpoint to call them.
MODEL_WONDER=muse-wonder-1.0
MODEL_SPARK=muse-spark-1.3
MODEL_SPARK_CONTRIB=muse-spark-1.3-contributor
MODEL_SPARK_OPEN=meta-models/muse-spark-open
MODEL_GLIMMER=meta-models/Muse-Glimmer-30B

# Live episode playback. 1.0 = real time (5 min hydraulic step takes 5 min).
# Seconds of wall clock per 5-minute hydraulic step. 1.15 plays the storm in about 20s, then it loops.
EPISODE_STEP_SECONDS=1.15

# Set to 1 to force the offline physics/vision path even when API keys are present.
STORMGATE_OFFLINE=0

# Hosted Wonder calls for the life of the process. The looping storm stays local.
# The budget is spent on the first beat after a gate jam, not on every 5-minute step.
# Muse Image is a separate single call, used the first time the outfall plate renders.
STORMGATE_HOSTED_BUDGET=1
